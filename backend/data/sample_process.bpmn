<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:meta="http://bpm-redesign-engine/schema/meta"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="Start"/>

    <bpmn:task id="Task_A" name="Review Application">
      <bpmn:extensionElements>
        <meta:metrics duration="4" cost="40" resource="Officer"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="Task_B" name="Check Documents">
      <bpmn:extensionElements>
        <meta:metrics duration="3" cost="30" resource="Clerk"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_1" name="Approved?"/>

    <bpmn:task id="Task_C" name="Send Approval">
      <bpmn:extensionElements>
        <meta:metrics duration="1" cost="10" resource="System"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="Task_D" name="Send Rejection">
      <bpmn:extensionElements>
        <meta:metrics duration="1" cost="10" resource="System"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="End"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_A"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_A" targetRef="Task_B"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_B" targetRef="Gateway_1"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_1" targetRef="Task_C">
      <bpmn:extensionElements>
        <meta:probability value="0.7"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_1" targetRef="Task_D">
      <bpmn:extensionElements>
        <meta:probability value="0.3"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_C" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_D" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>